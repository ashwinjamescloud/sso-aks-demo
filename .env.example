# --- Entra ID (Azure AD) App Registration ---
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
# Client secret is only used for the confidential-client SSO flow (browser login).
# It is NOT used for Managed Identity / Key Vault access.
ENTRA_CLIENT_SECRET=your-client-secret-value
REDIRECT_URI=http://localhost:3000/auth/redirect
POST_LOGOUT_REDIRECT_URI=http://localhost:3000

# --- Session ---
SESSION_SECRET=change-me-to-a-random-string

# --- Azure Key Vault (accessed via Managed/Workload Identity, no secret needed) ---
KEYVAULT_URL=https://your-keyvault-name.vault.azure.net
KEYVAULT_SECRET_NAME=demo-secret

# Optional: only needed for *local* dev if you want to impersonate a specific
# user-assigned managed identity via `az login`. Leave blank in AKS - the
# workload identity webhook injects these automatically.
# AZURE_CLIENT_ID=
