<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>SSO + AKS + Managed Identity Demo</title>
  <style>
    body { font-family: system-ui, sans-serif; max-width: 640px; margin: 60px auto; color: #1a1a1a; }
    a.button { display: inline-block; padding: 10px 18px; background: #0f6cbd; color: #fff;
      text-decoration: none; border-radius: 6px; margin-top: 12px; }
    code { background: #f2f2f2; padding: 2px 6px; border-radius: 4px; }
  </style>
</head>
<body>
  <h1>SSO + Managed Identity + AKS Demo</h1>
  <% if (user) { %>
    <p>Signed in as <strong><%= user.name %></strong> (<%= user.username %>).</p>
    <a class="button" href="/secret">Read a Key Vault secret via Managed Identity</a>
    <p><a href="/auth/signout">Sign out</a></p>
  <% } else { %>
    <p>You are not signed in.</p>
    <a class="button" href="/auth/signin">Sign in with Entra ID (SSO)</a>
  <% } %>
</body>
</html>
