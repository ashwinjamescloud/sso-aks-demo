<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Key Vault Secret</title>
  <style>
    body { font-family: system-ui, sans-serif; max-width: 640px; margin: 60px auto; color: #1a1a1a; }
    .card { border: 1px solid #ddd; border-radius: 8px; padding: 16px 20px; margin-top: 16px; }
    .error { color: #b40000; }
    a { color: #0f6cbd; }
  </style>
</head>
<body>
  <p>Signed in as <strong><%= user.name %></strong>. <a href="/">Home</a> | <a href="/auth/signout">Sign out</a></p>
  <h1>Key Vault Secret</h1>
  <% if (error) { %>
    <div class="card error">
      <p>Could not read secret <code><%= secretName %></code>:</p>
      <p><%= error %></p>
      <p>This usually means the pod's Managed/Workload Identity has not
         been granted the <code>Key Vault Secrets User</code> role yet, or
         (locally) that <code>az login</code> hasn't been run.</p>
    </div>
  <% } else { %>
    <div class="card">
      <p>Secret name: <code><%= secretName %></code></p>
      <p>Value: <code><%= secretValue %></code></p>
      <p>Last updated: <%= updatedOn %></p>
    </div>
    <p>This value was fetched with <code>DefaultAzureCredential</code> - no
       secret or connection string is stored in this app.</p>
  <% } %>
</body>
</html>
